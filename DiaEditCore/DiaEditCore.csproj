<Project Sdk="Microsoft.NET.Sdk">
 
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
 
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
  </ItemGroup>
 
  <Target Name="RunDocGen" AfterTargets="Build">
    <Exec Command="dotnet run --project &quot;$(SolutionDir)DiaEdit.DocGen&quot; -- --project DiaEditCore --src &quot;$(MSBuildProjectDirectory)&quot; --doc &quot;$(SolutionDir)DiaEdit_exe_App_Design_v14_0.md&quot; --manifest &quot;$(SolutionDir)DiaEdit.DocGen/docgen-manifest.json&quot;" />
  </Target>

</Project>