<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DiaEditApp.ViewModels"
        xmlns:nav="using:DiaEditApp.ViewModels.Navigation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
        x:Class="DiaEditApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="DiaEditApp">
        <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
        </Window.KeyBindings>

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE.
             To set the actual DataContext for runtime, set the DataContext property in code, see App.axaml.cs. -->
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4" Spacing="4">
            <Button Content="元に戻す" Command="{Binding UndoCommand}" />
            <Button Content="やり直し" Command="{Binding RedoCommand}" />
            <Button Content="保存"     Command="{Binding SaveCommand}" />
        </StackPanel>

        <Border DockPanel.Dock="Top"
                IsVisible="{Binding HasSaveError}"
                Background="#FFDD9999" Padding="8" Margin="0,4">
            <TextBlock Text="{Binding SaveErrorMessage}" TextWrapping="Wrap" Foreground="DarkRed" />
        </Border>

        <Grid ColumnDefinitions="240,*">

            <!-- 左ペイン：ナビゲーションツリー（UI設計書2.1節・4.1節） -->
            <TreeView Grid.Column="0"
                      ItemsSource="{Binding RootNodes}"
                      SelectedItem="{Binding SelectedNode, Mode=TwoWay}">
                <TreeView.ItemTemplate>
                    <TreeDataTemplate ItemsSource="{Binding Children}"
                                       DataType="nav:NavigationNodeViewModel">
                        <TextBlock Text="{Binding Header}" />
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <!-- 中央ペイン：メインワークスペース。ViewLocator（命名規則）でView解決 -->
            <ContentControl Grid.Column="1"
                             Content="{Binding CurrentContent}"
                             Margin="8" />

        </Grid>

    </DockPanel>

</Window>
