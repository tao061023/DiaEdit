<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DiaEditCore\DiaEditCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  
  <Target Name="RunDocGen" AfterTargets="Build">
    <Exec Command="dotnet run --project &quot;$(SolutionDir)DiaEdit.DocGen&quot; -- --project DiaEditApp.ViewModels --src &quot;$(MSBuildProjectDirectory)&quot; --doc &quot;$(SolutionDir)DiaEdit_exe_App_Design_v14_0.md&quot; --manifest &quot;$(SolutionDir)DiaEdit.DocGen/docgen-manifest.json&quot;" />
  </Target>
</Project>
 